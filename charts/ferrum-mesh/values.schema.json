          "type": "string"
        }
      }
    },
    "ambientSecurityContext": {
      "type": "object",
      "description": "Explicit ambient container SecurityContext. Only the keys listed here are read by the template, so unknown keys are REJECTED rather than silently ignored: runAsUser/runAsGroup are decided by the capture mode, allowPrivilegeEscalation defaults to false for Restricted (an explicit true is an operator override), and the capability set is a datapath requirement. capabilities.drop must stay [ALL] (omit the key for the default; an explicit empty list is rejected). capabilities.add merges on top of the required NET_ADMIN/NET_RAW (plus BPF/PERFMON for NodeWaypoint and SYS_ADMIN/SYS_PTRACE for in-netns capture) set and can never remove one. ALL and CAP_ALL are rejected in add: they would re-grant the complete Linux capability set after drop ALL. Required capability names are rendered unquoted.",
      "additionalProperties": false,
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array",
              "description": "Must remain [\"ALL\"] (omit the key for that default). An explicit empty list is rejected rather than rewritten. The rendered add list is the complete privilege surface.",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(CAP_)?[A-Z][A-Z0-9_]*$"
              }
            },
            "add": {
              "type": "array",
              "description": "Extra named capabilities merged on top of the datapath minimum. Required capabilities are always rendered regardless of this list. Names must match ^(CAP_)?[A-Z][A-Z0-9_]*$; empty strings and YAML punctuation are rejected. ALL and CAP_ALL are rejected: they would re-grant the complete Linux capability set after drop ALL.",
              "items": {
                "type": "string",
                "pattern": "^(CAP_)?[A-Z][A-Z0-9_]*$",
                "minLength": 1,
                "not": {
                  "enum": ["ALL", "CAP_ALL"]
                }
              }
            }
          }
        }
      }
    },
    "workloadResources": {
      "type": "object",
      "description": "Kubernetes ResourceRequirements. Serving workloads require non-empty requests.cpu and requests.memory.",
      "additionalProperties": true
    },
    "prometheusMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "tlsConfig": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "workloadProbes": {
      "type": "object",
      "description": "Per-workload health probes. Where an admin listener exists, liveness/startup use `ferrum-edge health --live` (GET /live) and readiness uses `ferrum-edge health` (GET /health). East-west uses the same drain-aware admin health pair. Injector defaults use a TCP probe on the webhook port. Overrides are per-probe (startup/liveness/readiness) so handlers cannot be silently coupled; when startup.override is unset, templates may still fall back to the liveness handler for backward compatibility.",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "override": {
              "type": "object",
              "description": "Custom startup handler (exec/httpGet/tcpSocket) replacing the computed default. When unset, the rendered startup probe falls back to the liveness handler (including any liveness.override) unless a workload template classifies startup independently."
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "override": {
              "type": "object",
              "description": "Custom liveness handler (exec/httpGet/tcpSocket) replacing the computed default. Also used by startup when startup.override is unset (backward-compatible fallback)."
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "override": {
              "type": "object",
              "description": "Custom readiness handler (exec/httpGet/tcpSocket) replacing the computed default."
            }
          }
        }
      }
    }
  }
