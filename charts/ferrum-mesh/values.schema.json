{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ferrum-mesh values",
  "description": "Values for the ferrum-mesh chart (control plane, injector, ambient, east-west, CA, observability, node-agent). Core gateway database/file/cp/dp modes belong in the ferrum-gateway chart.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "namespace": {
      "type": "string",
      "description": "Documented default release namespace hint. Templates render into .Release.Namespace; install with --namespace to select the target namespace."
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "description": "Set to null to clear the default and select maxUnavailable instead.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "crds": {
      "type": "object",
      "description": "Ferrum-owned CRD lifecycle. UDPResponseAmplificationPolicy is rendered from templates/ so helm upgrade applies schema changes. Helm's crds/ directory is install-once and is not used for this CRD.",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean",
          "description": "Render the Ferrum-owned UDPResponseAmplificationPolicy CRD so helm upgrade can update it. Default true."
        },
        "skipInstallAcknowledged": {
          "type": "boolean",
          "description": "Required when install=false. Confirms the operator applied the CRD out of band and accepts that helm upgrade will not update it."
        },
        "adoptExisting": {
          "type": "boolean",
          "description": "Required once when adopting a CRD installed by an older chart's crds/ directory (no Helm release ownership). Pair with helm upgrade --take-ownership."
        },
        "udpResponseAmplificationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "v1alpha1-1",
              "description": "Chart-owned schema marker stamped on the CRD as gateway.ferrum.io/crd-schema-version. Compare the live CRD annotation to this value."
            }
          }
        }
      }
    },
    "gatewayClass": {
      "type": "object",
      "description": "Cluster-scoped GatewayClass Ferrum owns. Create is the install-time authority object; Ferrum never infers ownership from the class name spelling. Independent releases in one cluster must use unique names; Helm will not import another release's GatewayClass.",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "controllerName": {
          "type": "string",
          "const": "ferrum.io/gateway-controller"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "description": "Mesh control-plane Deployment (Ferrum binary in cp mode). Distinct from ferrum-gateway mode=cp installs.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "grpcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "gatewayApi": {
              "type": "boolean"
            },
            "istio": {
              "type": "boolean"
            },
            "meshConfig": {
              "type": "boolean"
            },
            "podDiscovery": {
              "type": "boolean"
            },
            "nodeLocality": {
              "type": "boolean"
            }
          }
        },
        "env": {
          "type": "object",
          "description": "Free-form control-plane env map. Reserved DB/JWT keys must use controlPlane.database or controlPlane.credentials.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "",
                "sqlite",
                "postgres",
                "mysql",
                "mongodb"
              ]
            },
            "url": {
              "type": "string"
            },
            "urlFrom": {
              "type": "object",
              "description": "Free-form Kubernetes EnvVarSource for FERRUM_DB_URL.",
              "additionalProperties": true
            },
            "existingSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "urlKey": {
                  "type": "string"
                }
              }
            },
            "sqlite": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "",
                    "ro",
                    "rw",
                    "rwc",
                    "memory"
                  ]
                }
              }
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "usernameFrom": {
              "type": "object",
              "description": "Rejected at render: structured Secret-backed username cannot be safely percent-encoded. Use existingSecret or urlFrom with a fully encoded URL Secret.",
              "additionalProperties": true
            },
            "password": {
              "type": "string"
            },
            "passwordFrom": {
              "type": "object",
              "description": "Rejected at render: structured Secret-backed password cannot be safely percent-encoded. Use existingSecret or urlFrom with a fully encoded URL Secret.",
              "additionalProperties": true
            },
            "existingCredentialsSecret": {
              "type": "object",
              "description": "Rejected at render: structured Secret-backed username/password cannot be safely percent-encoded. Use existingSecret or urlFrom with a fully encoded URL Secret.",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "usernameKey": {
                  "type": "string"
                },
                "passwordKey": {
                  "type": "string"
                }
              }
            },
            "params": {
              "type": "object",
              "description": "Free-form query-parameter map for structured database URLs.",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              }
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adminJwtSecret": {
              "$ref": "#/definitions/secretSource"
            },
            "cpDpGrpcJwtSecret": {
              "$ref": "#/definitions/secretSource"
            }
          }
        },
        "probes": {
          "$ref": "#/definitions/workloadProbes"
        },
        "admin": {
          "$ref": "#/definitions/workloadAdmin"
        },
        "shutdownDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreStopSeconds": {
          "$ref": "#/definitions/shutdownSeconds",
          "description": "Seconds of native lifecycle.preStop.sleep before SIGTERM. Requires Kubernetes 1.29+; 0 omits the hook. Counts against terminationGracePeriodSeconds."
        },
        "shutdownPreDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds",
          "description": "FERRUM_SHUTDOWN_PREDRAIN_SECONDS. Counts against terminationGracePeriodSeconds."
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Free-form Kubernetes PodSecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "securityContext": {
          "type": "object",
          "description": "Free-form Kubernetes container SecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "resources": {
          "$ref": "#/definitions/workloadResources"
        },
        "priorityClassName": {
          "type": "string"
        },
        "extraVolumes": {
          "type": "array",
          "description": "Free-form extra control-plane pod volumes (Kubernetes Volume objects). A multi-namespace CP (FERRUM_CP_NAMESPACES=* or a CSV set) must mount a real file at FERRUM_CP_DP_GRPC_TRUST_BUNDLE_PATH (advisory GHSA-3f2j-wwqw-grmg).",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "description": "Free-form extra control-plane container volume mounts (Kubernetes VolumeMount objects), e.g. the CP/DP trust bundle at FERRUM_CP_DP_GRPC_TRUST_BUNDLE_PATH.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "topologySpreadConstraints": {
          "type": "array",
          "description": "Optional Kubernetes TopologySpreadConstraint list. When unset and replicas >= 2, the chart spreads pods across kubernetes.io/hostname. An explicit empty list disables the default.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "injector": {
      "type": "object",
      "description": "Sidecar injector webhook (Ferrum binary in injector mode). Not available in ferrum-gateway.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "listenPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "requireAnnotation": {
          "type": "boolean",
          "description": "Require a per-pod opt-in annotation/label before injecting. Independent of this gate, pods with spec.hostNetwork: true are never injected -- they share the node's network namespace, so capture rules would rewrite the node's own iptables and sidecar listeners would bind node-wide; such pods are admitted unmodified and logged."
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Fail",
            "Ignore"
          ]
        },
        "caBundle": {
          "type": "string",
          "description": "Base64-encoded PEM CA that validates the injector webhook serving certificate. Mutually exclusive with certManager.injectCaFrom. Required (exactly one trust source) when injector.enabled=true."
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "injectCaFrom": {
              "type": "string",
              "description": "cert-manager.io/inject-ca-from value (namespace/certificate-name). Mutually exclusive with caBundle. Empty disables the annotation."
            }
          }
        },
        "namespaceSelector": {
          "type": "object",
          "description": "Additional Kubernetes LabelSelector matchExpressions for the mutating webhook. The chart always appends a NotIn rule for the Helm release namespace at render time; see charts/ferrum-mesh/README.md.",
          "additionalProperties": true
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Free-form Kubernetes PodSecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "securityContext": {
          "type": "object",
          "description": "Free-form Kubernetes container SecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "description": "Free-form Kubernetes ResourceRequirements.",
          "additionalProperties": true
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "certPath": {
              "type": "string"
            },
            "keyPath": {
              "type": "string"
            }
          }
        },
        "env": {
          "type": "object",
          "description": "Free-form injector env map.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "probes": {
          "$ref": "#/definitions/workloadProbes"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "description": "Optional Kubernetes TopologySpreadConstraint list. When unset and replicas >= 2, the chart spreads pods across kubernetes.io/hostname. An explicit empty list disables the default.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "ambient": {
      "type": "object",
      "description": "Ambient mesh DaemonSet (Ferrum binary in mesh mode with ambient topology). Not available in ferrum-gateway.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "inboundPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "outboundPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hbonePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "captureMode": {
          "type": "string"
        },
        "extraVolumes": {
          "type": "array",
          "description": "Free-form extra ambient/NodeWaypoint pod volumes (Kubernetes Volume objects), e.g. the frontend DTLS cert/key a NodeWaypoint UDP/DTLS service listener terminates with.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "description": "Free-form extra ambient/NodeWaypoint container volume mounts (Kubernetes VolumeMount objects), e.g. the DTLS material at FERRUM_DTLS_CERT_PATH / FERRUM_DTLS_KEY_PATH.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "udpNodePreflight": {
          "type": "object",
          "description": "Privileged one-shot Ambient UDP node preflight init container for the settled host-netns placement. It runs in the ambient pod itself so Kubernetes orders it before the steady-state proxy container, and reads target pids through a read-only host /proc mount instead of pod-scoped hostPID. The ambient pod disables automatic ServiceAccount token projection and mounts a short-lived kube-api-access volume into the proxy always and into this init container only when no explicit FERRUM_K8S_NODE_UID is set. Disabling it never relaxes the runtime proof boundary.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "spire": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "socketHostPath": {
              "type": "string"
            },
            "socketMountPath": {
              "type": "string"
            },
            "socketFileName": {
              "type": "string"
            },
            "workloadSpiffeId": {
              "type": "string"
            },
            "productionMode": {
              "type": "boolean"
            }
          }
        },
        "env": {
          "type": "object",
          "description": "Free-form ambient mesh env map.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "probes": {
          "$ref": "#/definitions/workloadProbes"
        },
        "admin": {
          "$ref": "#/definitions/workloadAdmin"
        },
        "shutdownDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreStopSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Free-form Kubernetes PodSecurityContext, rendered verbatim. hostNetwork and the container capability set are decided by the datapath, not here.",
          "additionalProperties": true
        },
        "securityContext": {
          "$ref": "#/definitions/ambientSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/workloadResources"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "eastWest": {
      "type": "object",
      "description": "East-west gateway Deployment (Ferrum binary in mesh mode with east_west_gateway topology). Not available in ferrum-gateway.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "listenPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "env": {
          "type": "object",
          "description": "Free-form east-west gateway env map.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "probes": {
          "$ref": "#/definitions/workloadProbes"
        },
        "admin": {
          "$ref": "#/definitions/workloadAdmin"
        },
        "shutdownDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreStopSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Free-form Kubernetes PodSecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "securityContext": {
          "type": "object",
          "description": "Free-form Kubernetes container SecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "resources": {
          "$ref": "#/definitions/workloadResources"
        },
        "priorityClassName": {
          "type": "string"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "description": "Optional Kubernetes TopologySpreadConstraint list. When unset and replicas >= 2, the chart spreads pods across kubernetes.io/hostname. An explicit empty list disables the default.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "ca": {
      "type": "object",
      "description": "Mesh CA Deployment (shares controlPlane database/JWT contract when enabled).",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "description": "Free-form CA env map.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "probes": {
          "$ref": "#/definitions/workloadProbes"
        },
        "admin": {
          "$ref": "#/definitions/workloadAdmin"
        },
        "shutdownDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreStopSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "shutdownPreDrainSeconds": {
          "$ref": "#/definitions/shutdownSeconds"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Free-form Kubernetes PodSecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "securityContext": {
          "type": "object",
          "description": "Free-form Kubernetes container SecurityContext, rendered verbatim.",
          "additionalProperties": true
        },
        "resources": {
          "$ref": "#/definitions/workloadResources"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedCidrs": {
              "type": "string"
            },
            "bearerToken": {
              "$ref": "#/definitions/secretSource"
            },
            "serviceMonitor": {
              "$ref": "#/definitions/prometheusMonitor"
            },
            "podMonitor": {
              "$ref": "#/definitions/prometheusMonitor"
            }
          }
        },
        "dashboards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sidecarLabel": {
              "type": "string"
            },
            "sidecarLabelValue": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "description": "Free-form extra labels on the dashboard ConfigMap.",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              }
            },
            "annotations": {
              "type": "object",
              "description": "Free-form annotations on the dashboard ConfigMap.",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              }
            },
            "configMapName": {
              "type": "string"
            }
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "certExpiringSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "svidExpiringCriticalSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "cpStaleConfigSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "policyDenyRatePerSecond": {
              "type": "number",
              "minimum": 0
            },
            "mtlsHandshakeFailureRatePerSecond": {
              "type": "number",
              "minimum": 0
            },
            "injectorFailureRatePerSecond": {
              "type": "number",
              "minimum": 0
            },
            "federationBundleStaleSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "nodeAgent": {
      "type": "object",
      "description": "Node-agent DaemonSet (Ferrum binary in node_agent mode). Not available in ferrum-gateway.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "description": "Free-form node-agent env map.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "captureMode": {
          "type": "string"
        },
        "proxyMode": {
          "type": "string"
        },
        "proxyUid": {
          "type": "integer",
          "minimum": 0
        },
        "ingressRedirectIfaces": {
          "type": "string",
          "description": "Comma-separated explicit host interfaces for the optional NodeWaypoint tc ingress redirect (maximum 16); empty disables it. The node agent never auto-selects or broadens this set and keeps readiness false unless the exact set completely covers supported per-family remote PodCIDR/InternalIP route evidence. Complete evidence contributes regardless of peer Ready health; incomplete non-Ready joining/rebooting/draining Nodes are ignored, while incomplete Ready=True evidence fails closed. Single-node/no-remote-evidence and alternate-policy-routing topologies are unsupported; leave empty when there is no off-node path."
        },
        "trustedKubeletProbeSourceIps": {
          "type": "string"
        },
        "podRegistryDir": {
          "type": "string"
        },
        "cgroupRoot": {
          "type": "string"
        },
        "bpfFsPath": {
          "type": "string"
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "bindAddress": {
              "type": "string"
            },
            "port": {
