# Rust
/target/
**/target/
**/*.rs.bk
fuzz/artifacts/
fuzz/target/

# cargo-llvm-cov instrumented target dirs (scripts/coverage.sh)
target/llvm-cov/
target/llvm-cov-target/

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment files
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp

# Comparison benchmark results (regenerated each run)
comparison/results/*.txt
comparison/results/*.html
comparison/results/*.json

# Performance test artifacts
tests/performance/ci_results/

# CI sccache local-disk cache (persisted via rust-cache cache-directories)
/.cache/

# Runtime state of a gateway started from the checkout: the default
# FERRUM_TLS_MANAGED_STORE_PATH (managed TLS records, including private keys,
# and the TLS event log). Never commit it. Tests keep their stores in private
# temp dirs, and CI fails if a test run recreates this directory.
/ferrum-managed-tls/

# Perf harness runtime configs generated by prepare_ferrum_config (CA_PATH substitution)
tests/performance/multi_protocol/ferrum_runtime_*.yaml
