+            let (client, conn) = http1_client("reused").await;
+            let mut pooled = reused(&pool, client).await;
+            assert_eq!(watch(&mut pooled).await, Poll::Ready(Ok(())));
+
+            drop(conn);
+            assert_eq!(watch(&mut pooled).await, Poll::Ready(Err(())));
+        }
+
+        #[tokio::test]
+        async fn release_records_reuse_and_conn_info() {
+            let (client, _fresh_conn) = http1_client("fresh").await;
+            let (connection_reused, conn_info) = release_pool_conn(&fresh(&new_pool(), client));
+            assert!(!connection_reused);
+            assert_eq!(tag(&conn_info), Some(ConnTag("fresh")));
+
+            let pool = new_pool();
+            let (client, _reused_conn) = http1_client("reused").await;
+            let (connection_reused, conn_info) = release_pool_conn(&reused(&pool, client).await);
+            assert!(connection_reused);
+            assert_eq!(tag(&conn_info), Some(ConnTag("reused")));
+        }
+
+        #[tokio::test]
+        async fn unsent_request_on_released_connection_is_retryable_as_reused() {
+            let pool = new_pool();
+            let (client, conn) = http1_client("reused").await;
+            let mut pooled = reused(&pool, client).await;
+            drop(conn);
+            // What the stranded request's callback yields once the channel
+            // drops: a canceled error carrying the unsent request.
+            let unsent = pooled.try_send_request(Request::new(Empty::new())).await;
+            assert!(unsent.is_err());
+
+            let mut task = tokio_test::task::spawn(await_pooled_response(
+                resolves_after_release(unsent),
+                pooled,
+            ));
+            match task.poll() {
+                Poll::Ready(Err(TrySendError::Retryable {
+                    error,
+                    connection_reused,
+                    ..
+                })) => {
+                    // Recorded before the release dropped the connection.
+                    assert!(connection_reused);
+                    assert!(matches!(error.kind, ErrorKind::Canceled));
+                    assert_eq!(
+                        error.connect_info().and_then(tag),
+                        Some(ConnTag("reused"))
+                    );
+                }
+                Poll::Ready(Err(TrySendError::Nope(error))) => {
+                    panic!("unsent request is not retryable: {error:?}")
+                }
+                Poll::Ready(Ok(_)) => panic!("unsent request resolved as a response"),
+                Poll::Pending => panic!("closed connection was not released"),
+            }
+        }
+
+        #[tokio::test]
+        async fn response_on_released_connection_is_not_handed_back_for_the_pool() {
+            let pool = new_pool();
+            let (client, conn) = http1_client("reused").await;
+            let pooled = reused(&pool, client).await;
+            drop(conn);
+
+            let response = Ok::<_, ConnTrySendError<Request<Body>>>(Response::new(()));
+            let mut task = tokio_test::task::spawn(await_pooled_response(
+                resolves_after_release(response),
+                pooled,
+            ));
+            match task.poll() {
+                Poll::Ready(Ok((res, None))) => {
+                    assert_eq!(
+                        res.extensions().get::<ConnTag>(),
+                        Some(&ConnTag("reused"))
+                    );
+                }
+                Poll::Ready(Ok((_, Some(_)))) => {
+                    panic!("released connection handed back for the pool")
+                }
+                Poll::Ready(Err(_)) => panic!("response lost"),
+                Poll::Pending => panic!("closed connection was not released"),
+            }
+        }
+
+        #[tokio::test]
+        async fn request_queued_when_reused_connection_closes_is_retryable() {
+            let pool = new_pool();
+            let (client, conn) = http1_client("reused").await;
+            let mut pooled = reused(&pool, client).await;
+            let sent = pooled.try_send_request(Request::new(Empty::new()));
+            let mut task = tokio_test::task::spawn(await_pooled_response(sent, pooled));
+            assert!(task.poll().is_pending());
+
+            // The dispatcher goes away before it dequeues the request.
+            drop(conn);
+            assert!(task.is_woken());
+            match task.poll() {
+                Poll::Ready(Err(TrySendError::Retryable {
+                    error,
+                    connection_reused,
+                    ..
+                })) => {
+                    assert!(connection_reused);
+                    assert!(matches!(error.kind, ErrorKind::Canceled));
+                }
+                Poll::Ready(Err(TrySendError::Nope(error))) => {
+                    panic!("unsent request is not retryable: {error:?}")
+                }
+                Poll::Ready(Ok(_)) => panic!("unsent request resolved as a response"),
+                Poll::Pending => panic!("request still pending after its connection closed"),
+            }
+        }
+    }
+}
