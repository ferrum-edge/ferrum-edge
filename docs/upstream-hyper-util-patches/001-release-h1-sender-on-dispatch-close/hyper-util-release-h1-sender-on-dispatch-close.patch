+// Ferrum Edge patch hyper-util-001 regressions. The race itself sits between
+// two instructions inside tokio's `UnboundedSender::send`, so no public API can
+// schedule it. These tests build the state it leaves behind directly: a queued
+// request whose callback only fires when the last sender drops, on a
+// connection whose dispatcher has stopped reading.
+#[cfg(test)]
+mod ferrum_release_on_close_tests {
+    use super::{await_response_or_release, ConnSlot};
+    use std::future::Future;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::{Arc, Mutex};
+    use std::task::{Context, Poll, Waker};
+    use tokio::sync::oneshot;
+
+    type Callback = oneshot::Sender<Result<&'static str, &'static str>>;
+
+    const CANCELED: &str = "canceled: connection closed";
+
+    #[derive(Clone, Copy, PartialEq)]
+    enum DispatchState {
+        /// Serving or about to serve; has not asked for more work.
+        Busy,
+        /// Asked for another request after the queued one was published.
+        Wanting,
+        /// Closed its queue, or is gone.
+        Closed,
+    }
+
+    /// The dispatcher side of hyper's `want` handshake.
+    struct Dispatcher {
+        state: DispatchState,
+        waker: Option<Waker>,
+        polls: usize,
+    }
+
+    impl Dispatcher {
+        fn new(state: DispatchState) -> Arc<Mutex<Self>> {
+            Arc::new(Mutex::new(Dispatcher {
+                state,
+                waker: None,
+                polls: 0,
+            }))
+        }
+
+        fn set(this: &Arc<Mutex<Self>>, state: DispatchState) {
+            let waker = {
+                let mut dispatcher = this.lock().unwrap();
+                dispatcher.state = state;
+                dispatcher.waker.take()
+            };
+            if let Some(waker) = waker {
+                waker.wake();
+            }
+        }
+    }
+
+    /// The pooled connection: it owns the only sender of the request queue,
+    /// and the stranded envelope in that queue. Dropping it drops the queue,
+    /// and the envelope fails its callback, as `hyper`'s `Envelope::drop` does.
+    struct Conn {
+        dispatcher: Arc<Mutex<Dispatcher>>,
+        stranded: Option<Callback>,
+        dropped: Arc<AtomicUsize>,
+    }
+
+    impl Drop for Conn {
+        fn drop(&mut self) {
+            self.dropped.fetch_add(1, Ordering::SeqCst);
+            if let Some(callback) = self.stranded.take() {
+                let _ = callback.send(Err(CANCELED));
+            }
+        }
+    }
+
+    fn poll_conn(conn: &mut Conn, cx: &mut Context<'_>) -> Poll<Result<(), ()>> {
+        let mut dispatcher = conn.dispatcher.lock().unwrap();
+        dispatcher.polls += 1;
+        let state = dispatcher.state;
+        match state {
+            DispatchState::Busy => {
+                dispatcher.waker = Some(cx.waker().clone());
+                Poll::Pending
+            }
+            DispatchState::Wanting => Poll::Ready(Ok(())),
+            DispatchState::Closed => Poll::Ready(Err(())),
+        }
+    }
+
+    struct Fixture {
+        dispatcher: Arc<Mutex<Dispatcher>>,
+        dropped: Arc<AtomicUsize>,
+        conn: Conn,
+        response: oneshot::Receiver<Result<&'static str, &'static str>>,
+        /// `Some` when the dispatcher took the request; `None` when the request
+        /// is stranded in the queue the connection owns.
+        in_flight: Option<Callback>,
+    }
+
+    fn fixture(state: DispatchState, stranded: bool) -> Fixture {
