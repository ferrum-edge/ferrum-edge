+    #[test]
+    fn stranded_request_without_release_never_resolves() {
+        // The bug: the requester holds the only sender, so the envelope that
+        // missed the dispatcher's drain is never dropped.
+        let f = fixture(DispatchState::Busy, true);
+        let mut task = tokio_test::task::spawn(sent(f.response));
+        assert!(task.poll().is_pending());
+        Dispatcher::set(&f.dispatcher, DispatchState::Closed);
+        assert!(!task.is_woken());
+        assert!(task.poll().is_pending());
+        drop(f.conn);
+        assert!(task.is_woken());
+        assert_eq!(task.poll(), Poll::Ready(Err(CANCELED)));
+    }
+
+    #[test]
+    fn stranded_request_resolves_when_dispatcher_closes() {
+        let f = fixture(DispatchState::Busy, true);
+        let dropped = f.dropped.clone();
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            |_conn| "released",
+        ));
+        assert!(task.poll().is_pending());
+        assert_eq!(dropped.load(Ordering::SeqCst), 0);
+
+        // The dispatcher closes its queue without having seen the request.
+        Dispatcher::set(&f.dispatcher, DispatchState::Closed);
+        assert!(task.is_woken());
+        match task.poll() {
+            Poll::Ready((Err(err), ConnSlot::Released(released))) => {
+                assert_eq!(err, CANCELED);
+                assert_eq!(released, "released");
+            }
+            Poll::Ready((res, ConnSlot::Held(_))) => {
+                panic!("connection not released; response {res:?}")
+            }
+            Poll::Ready((res, ConnSlot::Released(_))) => panic!("unexpected response {res:?}"),
+            Poll::Pending => panic!("stranded request still pending after close"),
+        }
+        assert_eq!(dropped.load(Ordering::SeqCst), 1);
+    }
