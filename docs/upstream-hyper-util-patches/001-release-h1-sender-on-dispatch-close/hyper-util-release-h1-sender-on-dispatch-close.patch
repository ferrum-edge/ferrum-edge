+// Ferrum Edge patch hyper-util-001 regressions. The race itself sits between
+// two instructions inside tokio's `UnboundedSender::send`, so no public API can
+// schedule it. These tests build the state it leaves behind directly: a queued
+// request whose callback only fires when the last sender drops, on a
+// connection whose dispatcher has stopped reading.
+#[cfg(test)]
+mod ferrum_release_on_close_tests {
+    use super::{await_response_or_release, ConnSlot};
+    use std::future::Future;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::{Arc, Mutex};
+    use std::task::{Context, Poll, Waker};
+    use tokio::sync::oneshot;
+
+    type Callback = oneshot::Sender<Result<&'static str, &'static str>>;
+
+    const CANCELED: &str = "canceled: connection closed";
+
+    #[derive(Clone, Copy, PartialEq)]
+    enum DispatchState {
+        /// Serving or about to serve; has not asked for more work.
+        Busy,
+        /// Asked for another request after the queued one was published.
+        Wanting,
+        /// Closed its queue, or is gone.
+        Closed,
+    }
+
+    /// The dispatcher side of hyper's `want` handshake.
+    struct Dispatcher {
+        state: DispatchState,
+        waker: Option<Waker>,
+        polls: usize,
+    }
+
+    impl Dispatcher {
+        fn new(state: DispatchState) -> Arc<Mutex<Self>> {
+            Arc::new(Mutex::new(Dispatcher {
+                state,
+                waker: None,
+                polls: 0,
+            }))
+        }
+
+        fn set(this: &Arc<Mutex<Self>>, state: DispatchState) {
+            let waker = {
+                let mut dispatcher = this.lock().unwrap();
+                dispatcher.state = state;
+                dispatcher.waker.take()
+            };
+            if let Some(waker) = waker {
+                waker.wake();
+            }
+        }
+    }
+
+    /// The pooled connection: it owns the only sender of the request queue,
+    /// and the stranded envelope in that queue. Dropping it drops the queue,
+    /// and the envelope fails its callback, as `hyper`'s `Envelope::drop` does.
+    struct Conn {
+        dispatcher: Arc<Mutex<Dispatcher>>,
+        stranded: Option<Callback>,
+        dropped: Arc<AtomicUsize>,
+    }
+
+    impl Drop for Conn {
+        fn drop(&mut self) {
+            self.dropped.fetch_add(1, Ordering::SeqCst);
+            if let Some(callback) = self.stranded.take() {
+                let _ = callback.send(Err(CANCELED));
+            }
+        }
+    }
+
+    fn poll_conn(conn: &mut Conn, cx: &mut Context<'_>) -> Poll<Result<(), ()>> {
+        let mut dispatcher = conn.dispatcher.lock().unwrap();
+        dispatcher.polls += 1;
+        let state = dispatcher.state;
+        match state {
+            DispatchState::Busy => {
+                dispatcher.waker = Some(cx.waker().clone());
+                Poll::Pending
+            }
+            DispatchState::Wanting => Poll::Ready(Ok(())),
+            DispatchState::Closed => Poll::Ready(Err(())),
+        }
+    }
+
+    struct Fixture {
+        dispatcher: Arc<Mutex<Dispatcher>>,
+        dropped: Arc<AtomicUsize>,
+        conn: Conn,
+        response: oneshot::Receiver<Result<&'static str, &'static str>>,
+        /// `Some` when the dispatcher took the request; `None` when the request
+        /// is stranded in the queue the connection owns.
+        in_flight: Option<Callback>,
+    }
+
+    fn fixture(state: DispatchState, stranded: bool) -> Fixture {
+        let dispatcher = Dispatcher::new(state);
+        let dropped = Arc::new(AtomicUsize::new(0));
+        let (callback, response) = oneshot::channel();
+        let (stranded, in_flight) = if stranded {
+            (Some(callback), None)
+        } else {
+            (None, Some(callback))
+        };
+        Fixture {
+            conn: Conn {
+                dispatcher: dispatcher.clone(),
+                stranded,
+                dropped: dropped.clone(),
+            },
+            dispatcher,
+            dropped,
+            response,
+            in_flight,
+        }
+    }
+
+    fn sent(
+        response: oneshot::Receiver<Result<&'static str, &'static str>>,
+    ) -> impl Future<Output = Result<&'static str, &'static str>> {
+        async move { response.await.unwrap_or(Err("callback dropped")) }
+    }
+
+    #[test]
+    fn stranded_request_without_release_never_resolves() {
+        // The bug: the requester holds the only sender, so the envelope that
+        // missed the dispatcher's drain is never dropped.
+        let f = fixture(DispatchState::Busy, true);
+        let mut task = tokio_test::task::spawn(sent(f.response));
+        assert!(task.poll().is_pending());
+        Dispatcher::set(&f.dispatcher, DispatchState::Closed);
+        assert!(!task.is_woken());
+        assert!(task.poll().is_pending());
+        drop(f.conn);
+        assert!(task.is_woken());
+        assert_eq!(task.poll(), Poll::Ready(Err(CANCELED)));
+    }
+
+    #[test]
+    fn stranded_request_resolves_when_dispatcher_closes() {
+        let f = fixture(DispatchState::Busy, true);
+        let dropped = f.dropped.clone();
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            |_conn| "released",
+        ));
+        assert!(task.poll().is_pending());
+        assert_eq!(dropped.load(Ordering::SeqCst), 0);
+
+        // The dispatcher closes its queue without having seen the request.
+        Dispatcher::set(&f.dispatcher, DispatchState::Closed);
+        assert!(task.is_woken());
+        match task.poll() {
+            Poll::Ready((Err(err), ConnSlot::Released(released))) => {
+                assert_eq!(err, CANCELED);
+                assert_eq!(released, "released");
+            }
+            Poll::Ready((res, ConnSlot::Held(_))) => {
+                panic!("connection not released; response {res:?}")
+            }
+            Poll::Ready((res, ConnSlot::Released(_))) => panic!("unexpected response {res:?}"),
+            Poll::Pending => panic!("stranded request still pending after close"),
+        }
+        assert_eq!(dropped.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn stranded_request_on_already_closed_connection_resolves_on_first_poll() {
+        let f = fixture(DispatchState::Closed, true);
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            |_conn| (),
+        ));
+        assert!(matches!(
+            task.poll(),
+            Poll::Ready((Err(CANCELED), ConnSlot::Released(())))
+        ));
+    }
+
+    #[test]
+    fn response_delivered_before_close_wins_and_keeps_connection() {
+        let mut f = fixture(DispatchState::Closed, false);
+        let dropped = f.dropped.clone();
+        let _ = f.in_flight.take().unwrap().send(Ok("response"));
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            |_conn| (),
+        ));
+        match task.poll() {
+            Poll::Ready((Ok("response"), ConnSlot::Held(conn))) => drop(conn),
+            _ => panic!("expected the delivered response with the connection held"),
+        }
+        assert_eq!(f.dispatcher.lock().unwrap().polls, 0);
+        assert_eq!(dropped.load(Ordering::SeqCst), 1);
+    }
+
+    #[test]
+    fn in_flight_request_keeps_connection_until_response() {
+        let mut f = fixture(DispatchState::Busy, false);
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            |_conn| (),
+        ));
+        assert!(task.poll().is_pending());
+        assert!(task.poll().is_pending());
+        let _ = f.in_flight.take().unwrap().send(Ok("response"));
+        assert!(task.is_woken());
+        assert!(matches!(
+            task.poll(),
+            Poll::Ready((Ok("response"), ConnSlot::Held(_)))
+        ));
+    }
+
+    #[test]
+    fn wanting_dispatcher_ends_the_watch() {
+        // The dispatcher asked for more work after the request was published,
+        // so it saw the request; a later close is its business, not a strand.
+        let mut f = fixture(DispatchState::Wanting, false);
+        let dropped = f.dropped.clone();
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            |_conn| (),
+        ));
+        assert!(task.poll().is_pending());
+        Dispatcher::set(&f.dispatcher, DispatchState::Closed);
+        assert!(task.poll().is_pending());
+        assert_eq!(f.dispatcher.lock().unwrap().polls, 1);
+        assert_eq!(dropped.load(Ordering::SeqCst), 0);
+        let _ = f.in_flight.take().unwrap().send(Err("connection reset"));
+        assert!(matches!(
+            task.poll(),
+            Poll::Ready((Err("connection reset"), ConnSlot::Held(_)))
+        ));
+    }
+
+    #[test]
+    fn release_happens_once() {
+        // The dispatcher is gone but the request is still in flight on its
+        // way to a canceled callback; releasing twice would be a bug.
+        let mut f = fixture(DispatchState::Busy, false);
+        let releases = Arc::new(AtomicUsize::new(0));
+        let counted = releases.clone();
+        let mut task = tokio_test::task::spawn(await_response_or_release(
+            sent(f.response),
+            f.conn,
+            poll_conn,
+            move |_conn| {
+                counted.fetch_add(1, Ordering::SeqCst);
+            },
+        ));
+        assert!(task.poll().is_pending());
+        Dispatcher::set(&f.dispatcher, DispatchState::Closed);
+        assert!(task.poll().is_pending());
+        assert!(task.poll().is_pending());
+        assert_eq!(releases.load(Ordering::SeqCst), 1);
+        // One poll while busy, one that saw the close, none after the release.
+        assert_eq!(f.dispatcher.lock().unwrap().polls, 2);
+        let _ = f.in_flight.take().unwrap().send(Err("dispatch gone"));
+        assert!(matches!(
+            task.poll(),
+            Poll::Ready((Err("dispatch gone"), ConnSlot::Released(())))
+        ));
+    }
+
+    /// The watch relies on a real `hyper` HTTP/1 sender reporting closure
+    /// through `poll_ready` once its dispatcher is gone, with a request still
+    /// queued, and on that request failing with the unsent message.
+    #[tokio::test]
+    async fn hyper_http1_sender_reports_closed_with_request_queued() {
+        use http_body_util::Empty;
+        use hyper::body::Bytes;
+
+        let io = tokio_test::io::Builder::new().build();
+        let (mut sender, conn) = hyper::client::conn::http1::handshake::<_, Empty<Bytes>>(
+            crate::rt::TokioIo::new(io),
+        )
+        .await
+        .expect("handshake");
+        let sent = sender.try_send_request(super::Request::new(Empty::new()));
+        // The dispatcher never ran, so the request is queued, not dequeued.
+        drop(conn);
+
+        let (result, slot) = await_response_or_release(
+            sent,
+            sender,
+            |sender, cx| sender.poll_ready(cx).map_err(|_| ()),
+            |_sender| (),
+        )
+        .await;
+        let mut err = match result {
+            Ok(_) => panic!("request on a dropped connection must fail"),
+            Err(err) => err,
+        };
+        assert!(err.take_message().is_some());
+        assert!(err.into_error().is_canceled());
+        match slot {
+            ConnSlot::Held(mut sender) => {
+                let closed =
+                    std::future::poll_fn(|cx| Poll::Ready(sender.poll_ready(cx))).await;
+                assert!(closed.is_err());
+            }
+            ConnSlot::Released(()) => {}
+        }
+    }
+}
