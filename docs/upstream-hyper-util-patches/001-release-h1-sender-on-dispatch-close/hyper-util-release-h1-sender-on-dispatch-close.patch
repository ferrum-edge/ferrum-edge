+
+/// The connection handle a request was sent on: still held, or released after
+/// its dispatcher stopped reading requests, keeping only what the caller still
+/// needs (`R`).
+enum ConnSlot<T, R> {
+    Held(T),
+    Released(R),
+}
+
+type PoolConn<B> = pool::Pooled<PoolClient<B>, PoolKey>;
+
+/// What `try_send_request` still needs from a released connection: whether it
+/// was reused, and its connection info.
+type ReleasedConn = (bool, Connected);
+
+/// Waits for the response to a request `try_send_request` queued on `pooled`,
+/// releasing the connection once its HTTP/1 dispatcher stops reading requests
+/// (see `await_response_or_release`).
+///
+/// A request handed back unsent is retryable, with the reuse flag recorded
+/// before any release. A response on a released connection comes back with its
+/// extras set and no handle, because a closed connection has nothing to return
+/// to the pool.
+async fn await_pooled_response<B, R, F>(
+    sent: F,
+    pooled: PoolConn<B>,
+) -> Result<(Response<R>, Option<PoolConn<B>>), TrySendError<B>>
+where
+    B: Send + 'static,
+    F: Future<Output = Result<Response<R>, ConnTrySendError<Request<B>>>>,
+{
+    let (sent, slot) = await_response_or_release(
+        sent,
+        pooled,
+        poll_h1_dispatch_open::<B>,
+        release_pool_conn::<B>,
+    )
+    .await;
+
+    let mut res = match sent {
+        Ok(res) => res,
+        Err(mut err) => {
+            let (connection_reused, conn_info) = match slot {
+                ConnSlot::Held(pooled) => release_pool_conn(&pooled),
+                ConnSlot::Released(released) => released,
+            };
+            return if let Some(req) = err.take_message() {
+                Err(TrySendError::Retryable {
+                    connection_reused,
+                    error: e!(Canceled, err.into_error()).with_connect_info(conn_info),
+                    req,
+                })
+            } else {
+                Err(TrySendError::Nope(
+                    e!(SendRequest, err.into_error()).with_connect_info(conn_info),
+                ))
+            };
+        }
+    };
+
+    match slot {
+        ConnSlot::Held(pooled) => Ok((res, Some(pooled))),
+        ConnSlot::Released((_, conn_info)) => {
+            if let Some(extra) = &conn_info.extra {
+                extra.set(res.extensions_mut());
+            }
+            Ok((res, None))
+        }
     }
 }
 
+/// The readiness watch `await_pooled_response` runs on a pooled connection.
+///
+/// An HTTP/2 sender is a clone shared with the pool, so releasing this one
+/// would not drop the channel; the watch covers HTTP/1 only.
+fn poll_h1_dispatch_open<B>(
+    pooled: &mut PoolConn<B>,
+    cx: &mut task::Context<'_>,
+) -> Poll<Result<(), ()>>
+where
+    B: Send + 'static,
+{
+    if pooled.is_http1() {
+        pooled.poll_ready(cx).map_err(|_| ())
+    } else {
+        Poll::Ready(Ok(()))
+    }
+}
+
+fn release_pool_conn<B>(pooled: &PoolConn<B>) -> ReleasedConn
+where
+    B: Send + 'static,
+{
+    (pooled.is_reused(), pooled.conn_info.clone())
+}
+
+/// Waits for the response to a request already queued on `conn`, releasing
+/// `conn` as soon as its HTTP/1 dispatcher has stopped reading requests.
+///
+/// hyper queues an HTTP/1 request on a tokio unbounded channel. Tokio's
+/// `UnboundedSender::send` checks that the channel is open and publishes the
+/// message as two separate steps. If the connection task closes the channel
+/// between them (the backend reset or closed an idle connection), the
+/// dispatcher's `try_recv` sees nothing and dropping its receiver drains only
+/// messages that were already published. The request is then published into a
+/// channel nobody reads. Its callback resolves only when the channel itself is
+/// dropped, and `conn` holds the channel's only sender, so without this the
+/// response future waits for whatever timeout the caller has.
+///
+/// `poll_conn` returns `Ready(Err(()))` once the dispatcher is gone or has
+/// closed its queue. Dropping `conn` at that point drops the last sender, and
+/// the channel's destructor drops the stranded envelope, which fails the
+/// callback with a canceled error carrying the unsent request. That is the
+/// same outcome hyper gives a request its dispatcher dequeues after the
+/// connection failed, so the caller retries it or fails fast.
+///
+/// `Ready(Ok(()))` means the dispatcher asked for more work after this request
+/// was published, so it was not closed when the request arrived and will
+/// either serve it or cancel it; the watch ends there. `release` records what
+/// the caller still needs from `conn` before it is dropped.
+///
+/// `sent` is polled first on every wake, so a response or error the dispatcher
+/// delivered before closing always wins.
+async fn await_response_or_release<F, T, R>(
+    sent: F,
+    conn: T,
+    mut poll_conn: impl FnMut(&mut T, &mut task::Context<'_>) -> Poll<Result<(), ()>>,
+    release: impl FnOnce(&T) -> R,
+) -> (F::Output, ConnSlot<T, R>)
+where
+    F: Future,
+{
+    futures_util::pin_mut!(sent);
+    let mut slot = ConnSlot::Held(conn);
+    let mut release = Some(release);
+    let mut watching = true;
+    let output = poll_fn(|cx| loop {
+        if let Poll::Ready(output) = sent.as_mut().poll(cx) {
+            return Poll::Ready(output);
+        }
+        if !watching {
+            return Poll::Pending;
+        }
+        let released = match &mut slot {
+            ConnSlot::Held(conn) => match poll_conn(&mut *conn, &mut *cx) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Ok(())) => {
+                    watching = false;
+                    return Poll::Pending;
+                }
+                Poll::Ready(Err(())) => match release.take() {
+                    Some(release) => release(&*conn),
+                    None => return Poll::Pending,
+                },
+            },
+            ConnSlot::Released(_) => return Poll::Pending,
+        };
+        watching = false;
+        trace!("connection closed with a request queued; releasing its sender");
+        // Dropping the held handle drops the channel's last sender, which may
+        // resolve `sent` synchronously. Poll it again before parking.
+        slot = ConnSlot::Released(released);
+    })
+    .await;
+    (output, slot)
+}
