+            .map(Vec::as_slice)
+            .unwrap_or_default()
+    }
+
+    pub(crate) fn private_key(&self) -> &[u8] {
+        &self.private_key
+    }
+
+    pub(crate) fn into_parts(self) -> (Vec<Vec<u8>>, DtlsPrivateKey) {
+        (self.certificates, self.private_key)
+    }
+}
