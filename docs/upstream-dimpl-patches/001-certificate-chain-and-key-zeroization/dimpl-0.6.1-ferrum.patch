+/// Leaf-first certificate chain and its matching leaf private key.
+///
+/// The chain is kept in configured order and transmitted in full by both DTLS
+/// 1.2 and DTLS 1.3 certificate-authenticated handshakes.
+#[derive(Clone)]
+pub struct DtlsCertificateChain {
+    certificates: Vec<Vec<u8>>,
+    private_key: DtlsPrivateKey,
+}
+
+impl DtlsCertificateChain {
+    /// Maximum certificate count supported by the DTLS message parsers.
+    pub const MAX_CERTIFICATES: usize = 32;
+
+    /// Build a validated leaf-first certificate chain.
+    pub fn new(
+        certificates: Vec<Vec<u8>>,
+        private_key: impl Into<DtlsPrivateKey>,
+    ) -> Result<Self, String> {
+        // Convert before any fallible chain validation so failed construction
+        // still drops a zeroizing key owner.
+        let private_key = private_key.into();
+        if certificates.is_empty() {
+            return Err("DTLS certificate chain cannot be empty".to_string());
+        }
+        if certificates.len() > Self::MAX_CERTIFICATES {
+            return Err(format!(
+                "DTLS certificate chain contains {} certificates; maximum is {}",
+                certificates.len(),
+                Self::MAX_CERTIFICATES
+            ));
+        }
+        if let Some((index, _)) = certificates
+            .iter()
+            .enumerate()
+            .find(|(_, certificate)| certificate.is_empty())
+        {
+            return Err(format!(
+                "DTLS certificate chain entry {} cannot be empty",
+                index + 1
+            ));
+        }
+
+        const U24_MAX: usize = 0x00ff_ffff;
+        let mut encoded_len = 0usize;
+        for (index, certificate) in certificates.iter().enumerate() {
+            if certificate.len() > U24_MAX {
+                return Err(format!(
+                    "DTLS certificate chain entry {} exceeds the 24-bit wire length",
+                    index + 1
+                ));
+            }
+            // DTLS 1.3 adds a two-byte per-entry extensions length. Enforce
+            // the larger representation so the same credential is safe for
+            // explicit 1.2, explicit 1.3, and auto/fallback paths.
+            encoded_len = encoded_len
+                .checked_add(5 + certificate.len())
+                .ok_or_else(|| "DTLS certificate chain length overflow".to_string())?;
+        }
+        if encoded_len > U24_MAX {
+            return Err("DTLS certificate chain exceeds the 24-bit wire length".to_string());
+        }
+
+        if private_key.is_empty() {
+            return Err("DTLS private key cannot be empty".to_string());
+        }
+
+        Ok(Self {
+            certificates,
+            private_key,
+        })
+    }
+
+    /// Certificates in transmitted leaf-first order.
+    pub fn certificates(&self) -> &[Vec<u8>] {
+        &self.certificates
+    }
+
+    /// Leaf certificate used for signatures and fingerprints.
+    pub fn leaf_certificate(&self) -> &[u8] {
+        self.certificates
