+// Temporary diagnostic registry: weak handles only, never a connection owner.
+static REGISTRY: Mutex<Vec<Weak<Mutex<Inner>>>> = Mutex::new(Vec::new());
+static REGISTRY_VERSION: AtomicU64 = AtomicU64::new(0);
+static REGISTRY_LOSS: AtomicU64 = AtomicU64::new(0);
+static SNAPSHOT_LOCK: Mutex<()> = Mutex::new(());
+static GENERATION: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn guard_snapshot() -> String {
+    use super::guard_observe::{update, MEMORY_OVERFLOW, SEQUENCE, TARGET};
+    if !tracing::enabled!(target: TARGET, tracing::Level::DEBUG) {
+        return "# H2_GUARD_ACK_V2 ack=0\n".into();
+    }
+    let _serial = match SNAPSHOT_LOCK.try_lock() {
+        Ok(guard) => guard,
+        Err(_) => return "# H2_GUARD_ACK_V2 ack=0\n".into(),
+    };
+    // Five calls cover smoke + before/after both gRPC sizes. Sixteen is a
+    // bounded diagnostic request allowance, not a transport retry budget.
+    let previous = match update(&GENERATION,
+        |n| (n < 16).then_some(n + 1)) {
+        Ok(previous) => previous,
+        Err(_) => return "# H2_GUARD_ACK_V2 ack=0\n".into(),
+    };
+    let generation = previous + 1;
+    let version = REGISTRY_VERSION.load(Ordering::Relaxed);
+    let registry = match REGISTRY.try_lock() {
+        Ok(registry) => registry,
+        Err(_) => return "# H2_GUARD_ACK_V2 ack=0\n".into(),
+    };
+    let handles = registry.clone();
+    drop(registry); // Never acquire Inner while holding the registry lock.
+    let mut captured = 0;
+    let mut retired = 0;
+    let mut missed = 0;
+    for weak in &handles {
+        let inner = match weak.upgrade() {
+            Some(inner) => inner,
+            None => { retired += 1; continue; }
+        };
+        let snapshot = if let Ok(mut guard) = inner.try_lock() {
+            let me = &mut *guard;
+            let state = me.counts.guard_state();
+            me.counts.observation.as_mut().map(|observation| {
+                me.actions.recv.guard_window(observation);
+                (observation.clone(), state)
+            })
+        } else { None };
+        // Formatting and tracing are outside Inner; only one bounded clone
+        // exists at a time. No retries, wait loop, thread or task is created.
+        if let Some((mut observation, state)) = snapshot {
+            observation.emit_generation(3, 0, 0, state, generation);
+            captured += 1;
+        } else { missed += 1; }
+    }
+    let changed = u8::from(version != REGISTRY_VERSION.load(Ordering::Relaxed));
+    let seq = SEQUENCE.fetch_add(1, Ordering::Relaxed) + 1;
+    let loss = REGISTRY_LOSS.load(Ordering::Relaxed);
+    let memory = MEMORY_OVERFLOW.load(Ordering::Relaxed);
+    let suppressed = super::guard_observe::suppressed();
+    // This fence is also returned over HTTP, independently of the log sink.
+    // closed=0: a boundary prefix, never a claim of process shutdown/closure.
+    let fields = format!("seq={} generation={} registered={} captured={} retired={} missed={} changed={} registry_loss={} memory_overflow={} suppressed={} closed=0 ack=1",
+        seq, generation, handles.len(), captured, retired, missed, changed, loss, memory, suppressed);
+    tracing::debug!(target: TARGET, parent: None, "H2_GUARD_FENCE_V2 {}", fields);
+    format!("# H2_GUARD_ACK_V2 {}\n", fields)
+}
