{
  "enabled": true,
  "name": "5588-jemalloc-large-classes",
  "protocol": [
    "grpcs"
  ],
  "arms": [
    {
      "gateway": "ferrum",
      "FERRUM_EXTRA_ENV": "FERRUM_LOG_LEVEL=error"
    },
    {
      "gateway": "ferrum-exp-nslots",
      "FERRUM_EXTRA_ENV": "FERRUM_LOG_LEVEL=error _RJEM_MALLOC_CONF=tcache_nslots_large:128"
    },
    {
      "gateway": "ferrum-exp-percpu",
      "FERRUM_EXTRA_ENV": "FERRUM_LOG_LEVEL=error _RJEM_MALLOC_CONF=percpu_arena:percpu"
    },
    {
      "gateway": "ferrum-exp-both",
      "FERRUM_EXTRA_ENV": "FERRUM_LOG_LEVEL=error _RJEM_MALLOC_CONF=tcache_nslots_large:128,percpu_arena:percpu"
    }
  ]
}
