{
  "enabled": true,
  "name": "5588-deferred-first-write",
  "protocol": [
    "grpcs"
  ],
  "arms": [
    {
      "gateway": "ferrum",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_DEFER_FLUSH=off"
    },
    {
      "gateway": "ferrum-exp-frontend",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_DEFER_FLUSH=frontend"
    },
    {
      "gateway": "ferrum-exp-backend",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_DEFER_FLUSH=backend"
    },
    {
      "gateway": "ferrum-exp-both",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_DEFER_FLUSH=both"
    }
  ]
}
