{
  "enabled": true,
  "name": "5588-h2-body-write-timeout-isolate",
  "protocol": [
    "http2"
  ],
  "arms": [
    {
      "gateway": "ferrum",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_PASSTHROUGH_WT=1"
    },
    {
      "gateway": "ferrum-exp-noext",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_PASSTHROUGH_WT=0"
    },
    {
      "gateway": "ferrum-exp-nopollfirst",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_HYPER_POLL_FIRST=0"
    }
  ]
}
