{
  "enabled": true,
  "name": "5588-conn-affinity-deferred-write",
  "protocol": [
    "grpcs"
  ],
  "arms": [
    {
      "gateway": "ferrum",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_DEFER_FLUSH=off"
    },
    {
      "gateway": "ferrum-exp-frontend",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_DEFER_FLUSH=frontend"
    },
    {
      "gateway": "ferrum-exp-affinity",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_GRPC_CONN_AFFINITY=1"
    },
    {
      "gateway": "ferrum-exp-affinity-frontend",
      "FERRUM_EXTRA_ENV": "FERRUM_BENCH_GRPC_CONN_AFFINITY=1 FERRUM_BENCH_DEFER_FLUSH=frontend"
    }
  ]
}
