# Envoy client-side proxy, Istio-style sidecar egress shape:
# plaintext local listener (15101) -> HTTP/2 over mTLS to the server
# proxy inbound, matching Ferrum's H1 -> H2/mTLS -> H1 sidecar shape
# (15006) presenting the client workload certificate and pinning the
# server identity by DNS SAN. CERT_DIR is substituted by the harness.
admin:
  address:
    socket_address: { address: 127.0.0.1, port_value: 9901 }

static_resources:
  listeners:
    - name: outbound_plain
      address:
        socket_address: { address: 127.0.0.1, port_value: 15101 }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: mesh_outbound
                codec_type: HTTP1
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: svc
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/" }
                          route:
                            cluster: svc_mtls
                            timeout: 0s
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                access_log: []

  clusters:
    - name: svc_mtls
      connect_timeout: 5s
      type: STATIC
      lb_policy: ROUND_ROBIN
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
          sni: svc.ferrum.svc.cluster.local
          common_tls_context:
            alpn_protocols: ["h2"]
            tls_certificates:
              - certificate_chain: { filename: CERT_DIR/client/svid.crt }
                private_key: { filename: CERT_DIR/client/svid.key }
            validation_context:
              trusted_ca:
                filename: CERT_DIR/client/bundle.pem
              match_typed_subject_alt_names:
                - san_type: DNS
                  matcher: { exact: svc.ferrum.svc.cluster.local }
      load_assignment:
        cluster_name: svc_mtls
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: 127.0.0.1, port_value: 15006 }
