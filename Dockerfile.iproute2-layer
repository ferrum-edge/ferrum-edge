# syntax=docker/dockerfile:1
# Adds the `ip` executable required by NodeWaypoint ingress policy routing to an
# already-packaged Debian 13 distroless Ferrum image. Only the executable and
# its loader-resolved shared-object closure cross into the final image; no shell,
# package manager, or iptables fallback tools are shipped.
ARG BASE_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:cc66d222f0a7ec996b78a99fe76a969bc80b539a5016ad866c14d1949bc6d0ab
ARG IPROUTE2_BASE=debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
ARG IPROUTE2_VERSION=6.15.0-1
FROM ${BASE_IMAGE} AS runtime-base
FROM ${IPROUTE2_BASE} AS iproute2-runtime
ARG IPROUTE2_VERSION
COPY .github/scripts/stage_iproute2_runtime.sh /usr/local/bin/stage-iproute2-runtime
RUN --mount=from=runtime-base,source=/,target=/distroless-root,ro \
    /bin/sh /usr/local/bin/stage-iproute2-runtime \
        /iproute2-root /distroless-root "${IPROUTE2_VERSION}"

FROM runtime-base
COPY --from=iproute2-runtime /iproute2-root/usr/sbin/ip /usr/sbin/ip
COPY --from=iproute2-runtime /iproute2-root/usr/lib/ /usr/lib/
COPY --from=iproute2-runtime /iproute2-root/usr/lib64/ /usr/lib64/
USER 65532:65532
